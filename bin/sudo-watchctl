#!/usr/bin/env bash
# Convenience CLI for adjusting sudo-watch settings without hand-editing
# its config file. Changes apply live (next poll tick), no restart needed.
set -euo pipefail

CONFIG_FILE="${SUDO_WATCH_CONFIG:-$HOME/.config/sudo-watch/config}"
DEFAULT_SOUND="/usr/share/sounds/freedesktop/stereo/dialog-warning.oga"

usage() {
	cat <<EOF
Usage: sudo-watchctl <command> [args]

Commands:
  volume [percent]      Get or set base alert volume (e.g. 50, 100, 150)
  escalate [on|off]     Get or set whether volume ramps up on repeat alerts
  volume-step [n]       Get or set percent added per repeat alert (escalate)
  volume-max [percent]  Get or set the volume cap when escalating
  threshold [seconds]   Get or set seconds before the first alert
  repeat [seconds]      Get or set seconds between repeat alerts
  sound [path]          Get or set the alert sound file
  max-alerts [n|unlimited]  Get or set how many alerts one waiting prompt may
                        trigger before they stop (default 10; 0 = unlimited)
  widget [on|off|status]  Show, add or remove the bar widget (watcher keeps running)
  status                Show current settings and service state
  test                  Play the current alert sound at current volume
EOF
}

LOCK_FILE="${SUDO_WATCH_LOCK:-${XDG_RUNTIME_DIR:-$HOME/.cache}/sudo-watch.lock}"

# Digits only, bounded: matches what the watcher accepts, so a value the CLI
# writes is always one the watcher will honor.
is_uint() { [[ "$1" =~ ^[0-9]{1,9}$ ]]; }

# Volumes are capped well below anything pa_volume_t or a pair of ears can
# take; the watcher clamps to the same ceiling.
MAX_PERCENT=500
is_percent() { is_uint "$1" && (( 10#$1 <= MAX_PERCENT )); }

ensure_config() {
	mkdir -p -m 700 "$(dirname "$CONFIG_FILE")"
	[[ -f "$CONFIG_FILE" ]] || (umask 077; : > "$CONFIG_FILE")
}

# Exact-key lookup by literal prefix match (no regex built from the key).
get_kv() {
	local key="$1" default="$2"
	[[ -f "$CONFIG_FILE" ]] || { echo "$default"; return; }
	local val
	val="$(awk -v k="$key" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { if (v != "") print v }' "$CONFIG_FILE" 2>/dev/null)"
	# Same normalisation as the watcher's parser (CR, one pair of quotes), plus
	# dropping control characters so a hand-edited value can't inject terminal
	# escape sequences into `status`.
	val="${val%$'\r'}"
	if [[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
	val="${val//[[:cntrl:]]/}"
	echo "${val:-$default}"
}

# Numeric lookup: anything that isn't a plain bounded integer yields the
# default, exactly like the watcher. Never feed get_kv output into arithmetic
# directly -- bash evaluates variable contents (including array subscripts
# with command substitutions) as expressions.
get_num() {
	local val
	val="$(get_kv "$1" "$2")"
	if is_uint "$val"; then echo "$((10#$val))"; else echo "$2"; fi
}

# Rewrites the config via awk with the value passed through the environment
# (no sed/regex interpretation of it) into a private temp file, then renames
# it into place so readers never see a half-written file. Control characters
# (newlines especially) are rejected: a newline would smuggle in extra keys.
set_kv() {
	local key="$1" value="$2" target tmp
	if [[ "$value" == *[[:cntrl:]]* ]]; then
		echo "value contains control characters" >&2
		return 1
	fi
	ensure_config
	target="$(readlink -f "$CONFIG_FILE")"
	# Serialize concurrent writers (widget + CLI) so one can't clobber the
	# other's update; the lock is a sidecar file since the config itself is
	# replaced by rename.
	(
		flock 8
		tmp="$(umask 077; mktemp "${target}.XXXXXX")"
		if ! K="$key" V="$value" awk '
			BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
			index($0, k "=") == 1 { print k "=" v; found = 1; next }
			{ print }
			END { if (!found) print k "=" v }
		' "$target" > "$tmp"; then
			rm -f "$tmp"
			exit 1
		fi
		mv -f "$tmp" "$target"
	) 8>>"${target}.lock"
}

PLUGIN_ID="taylorburke.sudo-watch"
SHELL_CONFIG="${SUDO_WATCH_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}"

# True if the widget appears in any section of the bar layout.
widget_present() {
	[[ -f "$SHELL_CONFIG" ]] || return 1
	jq -e --arg id "$PLUGIN_ID" '[.bar.layout[]?[]? | select(.id == $id)] | length > 0' "$SHELL_CONFIG" >/dev/null 2>&1
}

# Edits shell.json with a jq program (extra jq args after the filter). Omarchy
# has no "remove from bar" command, `omarchy plugin disable` would also stop
# the watcher service (wrong for an alerting tool), and `omarchy bar put`
# silently does nothing for a plugin that is also listed under "plugins" --
# so we edit the layout ourselves. shell.json hot-reloads, so the edit is
# validated JSON, backed up, and renamed into place atomically.
shell_config_edit() {
	local filter="$1" target tmp
	shift
	target="$(readlink -f "$SHELL_CONFIG")"
	cp -p -- "$target" "${target}.bak.sudo-watch-$(date +%s)"
	tmp="$(umask 077; mktemp "${target}.XXXXXX")"
	if ! jq "$@" "$filter" "$target" > "$tmp" || ! jq -e . "$tmp" >/dev/null; then
		rm -f "$tmp"
		echo "failed to update $SHELL_CONFIG; left unchanged" >&2
		return 1
	fi
	chmod --reference="$target" -- "$tmp"
	mv -f -- "$tmp" "$target"
}

WIDGET_STATE="$(dirname "$CONFIG_FILE")/widget-position.json"

# Removes only this widget's entry, remembering its section, settings and the
# widget it sat after, so `widget on` can put it back in the same place.
widget_remove() {
	local state
	state="$(jq -c --arg id "$PLUGIN_ID" '
		.bar.layout | to_entries
		| map(.key as $sec | .value as $arr
			| ($arr | map(.id) | index($id)) as $i
			| select($i != null)
			| {section: $sec, entry: $arr[$i], after: (if $i > 0 then $arr[$i - 1].id else null end)})
		| first // empty' "$SHELL_CONFIG")"
	shell_config_edit '.bar.layout |= with_entries(.value |= map(select(.id != $id)))' --arg id "$PLUGIN_ID" || return 1
	if [[ -n "$state" ]]; then
		mkdir -p -m 700 "$(dirname "$WIDGET_STATE")"
		(umask 077; printf '%s\n' "$state" > "$WIDGET_STATE")
	fi
}

# Puts the widget back where `widget off` found it (or at the end of the
# right section if it has no saved spot, or its old neighbour is gone).
widget_add() {
	local state='{"section":"right","entry":{"id":"'"$PLUGIN_ID"'"},"after":""}'
	if [[ -f "$WIDGET_STATE" ]] && jq -e --arg id "$PLUGIN_ID" '.entry.id == $id and (.section | IN("left","center","right"))' "$WIDGET_STATE" >/dev/null 2>&1; then
		state="$(jq -c . "$WIDGET_STATE")"
	fi
	shell_config_edit '
		def where($arr):
			if $s.after == null then 0
			else (($arr | map(.id) | index($s.after))) as $i
				| if $i == null then ($arr | length) else $i + 1 end
			end;
		.bar.layout[$s.section] |= ((. // []) as $arr | where($arr) as $p | $arr[:$p] + [$s.entry] + $arr[$p:])' \
		--argjson s "$state"
}

# True if some process holds the watcher's single-instance lock.
watcher_running() {
	[[ -e "$LOCK_FILE" ]] || return 1
	! ( exec 9<"$LOCK_FILE" && flock -n 9 ) 2>/dev/null
}

main() {
	local cmd="${1:-status}"
	shift || true

	case "$cmd" in
	volume)
		if [[ $# -eq 0 ]]; then
			get_num SUDO_WATCH_VOLUME 100
		else
			is_percent "$1" || { echo "volume must be a non-negative integer percent (at most $MAX_PERCENT)" >&2; exit 1; }
			set_kv SUDO_WATCH_VOLUME "$1"
			echo "Alert volume set to ${1}%"
		fi
		;;
	escalate)
		if [[ $# -eq 0 ]]; then
			[[ "$(get_num SUDO_WATCH_VOLUME_ESCALATE 0)" == "1" ]] && echo "on" || echo "off"
		else
			case "$1" in
				on) set_kv SUDO_WATCH_VOLUME_ESCALATE 1; echo "Volume escalation on" ;;
				off) set_kv SUDO_WATCH_VOLUME_ESCALATE 0; echo "Volume escalation off" ;;
				*) echo "escalate expects 'on' or 'off'" >&2; exit 1 ;;
			esac
		fi
		;;
	volume-step)
		if [[ $# -eq 0 ]]; then
			get_num SUDO_WATCH_VOLUME_STEP 10
		else
			is_percent "$1" || { echo "volume-step must be a non-negative integer percent (at most $MAX_PERCENT)" >&2; exit 1; }
			set_kv SUDO_WATCH_VOLUME_STEP "$1"
			echo "Volume step set to ${1}%"
		fi
		;;
	volume-max)
		if [[ $# -eq 0 ]]; then
			get_num SUDO_WATCH_VOLUME_MAX 150
		else
			is_percent "$1" || { echo "volume-max must be a non-negative integer percent (at most $MAX_PERCENT)" >&2; exit 1; }
			set_kv SUDO_WATCH_VOLUME_MAX "$1"
			echo "Volume cap set to ${1}%"
		fi
		;;
	threshold)
		if [[ $# -eq 0 ]]; then
			get_num SUDO_WATCH_ALERT_THRESHOLD 20
		else
			is_uint "$1" || { echo "threshold must be a non-negative integer (seconds)" >&2; exit 1; }
			set_kv SUDO_WATCH_ALERT_THRESHOLD "$1"
			echo "Alert threshold set to ${1}s"
		fi
		;;
	repeat)
		if [[ $# -eq 0 ]]; then
			get_num SUDO_WATCH_REPEAT_INTERVAL 10
		else
			is_uint "$1" || { echo "repeat interval must be a non-negative integer (seconds)" >&2; exit 1; }
			set_kv SUDO_WATCH_REPEAT_INTERVAL "$1"
			echo "Repeat interval set to ${1}s"
		fi
		;;
	sound)
		if [[ $# -eq 0 ]]; then
			get_kv SUDO_WATCH_SOUND "$DEFAULT_SOUND"
		else
			[[ -f "$1" && -r "$1" ]] || { echo "no such file: $1" >&2; exit 1; }
			[[ "$1" == *[[:cntrl:]]* ]] && { echo "sound path contains control characters" >&2; exit 1; }
			set_kv SUDO_WATCH_SOUND "$1"
			echo "Alert sound set to $1"
		fi
		;;
	max-alerts)
		if [[ $# -eq 0 ]]; then
			n="$(get_num SUDO_WATCH_MAX_ALERTS 10)"
			if [[ "$n" == "0" ]]; then echo "unlimited"; else echo "$n"; fi
		else
			case "$1" in
				unlimited|0) set_kv SUDO_WATCH_MAX_ALERTS 0; echo "Alerts are unlimited" ;;
				*)
					is_uint "$1" || { echo "max-alerts must be a non-negative integer or 'unlimited'" >&2; exit 1; }
					set_kv SUDO_WATCH_MAX_ALERTS "$((10#$1))"
					echo "Alerts stop after ${1} per waiting prompt"
					;;
			esac
		fi
		;;
	widget)
		case "${1:-status}" in
			status)
				if widget_present; then echo "on"; else echo "off"; fi
				;;
			on)
				if widget_present; then
					echo "Widget already on the bar"
				else
					widget_add
					echo "Widget added to the bar"
				fi
				;;
			off)
				if widget_present; then
					widget_remove
					echo "Widget removed from the bar (the watcher is still running)"
				else
					echo "Widget already off the bar"
				fi
				;;
			*) echo "widget expects 'on', 'off' or 'status'" >&2; exit 1 ;;
		esac
		;;
	status)
		echo "Config file:  $CONFIG_FILE"
		echo "Volume:       $(get_num SUDO_WATCH_VOLUME 100)%"
		if [[ "$(get_num SUDO_WATCH_VOLUME_ESCALATE 0)" == "1" ]]; then
			echo "Escalate:     on (+$(get_num SUDO_WATCH_VOLUME_STEP 10)% per repeat, cap $(get_num SUDO_WATCH_VOLUME_MAX 150)%)"
		else
			echo "Escalate:     off"
		fi
		echo "Threshold:    $(get_num SUDO_WATCH_ALERT_THRESHOLD 20)s"
		echo "Repeat every: $(get_num SUDO_WATCH_REPEAT_INTERVAL 10)s"
		n="$(get_num SUDO_WATCH_MAX_ALERTS 10)"
		echo "Max alerts:   $([[ "$n" == "0" ]] && echo unlimited || echo "$n")"
		echo "Bar widget:   $(widget_present && echo on || echo off)"
		echo "Sound:        $(get_kv SUDO_WATCH_SOUND "$DEFAULT_SOUND")"
		if systemctl --user is-active --quiet sudo-watch.service 2>/dev/null; then
			echo "Service:      active (systemd)"
		elif watcher_running; then
			echo "Service:      active (plugin)"
		else
			echo "Service:      not active"
		fi
		;;
	test)
		vol="$(get_num SUDO_WATCH_VOLUME 100)"
		snd="$(get_kv SUDO_WATCH_SOUND "$DEFAULT_SOUND")"
		paplay --volume="$(( (vol > MAX_PERCENT ? MAX_PERCENT : vol) * 65536 / 100 ))" -- "$snd"
		;;
	-h|--help|help)
		usage
		;;
	*)
		echo "Unknown command: $cmd" >&2
		usage >&2
		exit 1
		;;
	esac
}

# Only run when executed directly, not when sourced (e.g. by tests) — lets
# tests load usage/ensure_config/get_kv/set_kv/main in isolation.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
